{
  "name": "cusp-lrn-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare-content": "node scripts/prepare-content.mjs",
    "dev": "CUSP_CONTENT=${CUSP_CONTENT:-sample} node scripts/prepare-content.mjs && next dev",
    "build": "node scripts/prepare-content.mjs && next build && node scripts/build-sw.mjs",
    "build:sample": "CUSP_CONTENT=sample pnpm build",
    "serve": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate-content": "tsx scripts/validate-content.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm validate-content"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "marked": "^17.0.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-fsrs": "^5.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fake-indexeddb": "^6.2.0",
    "globals": "^17.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  }
}
